def lexer(code):
    code = re.sub(r'//.*', '', code)
    token_pattern = re.compile(r'\b(HELP|SET|CROP|BLEND|ASK|AI|PICK|PLASMA|LOAD|AS|RGB|CANVAS|DRAW_RECT|DRAW_LINE|DRAW_CIRCLE|DRAW_TEXT|PASTE|CARTOON|VIEW|RESIZE|SEPIA|MULTIPLY|BY|MAX|OUTPUT|SAVE|RENDER|INVERT|ADD|SUBTRACT|THRESHOLD|FLIP|EDGES|BLUR|SHARPEN|WHITE|BLACK|RED|GREEN|BLUE|YELLOW)\b|(->)|([A-Za-z_]\w*)|(#[0-9A-Fa-f]{6})|(\d+\.\d+|\d+)|(\[|\]|\(|\)|,)|("[^"]+")')
    tokens = []
    for match in token_pattern.finditer(code):
        if match.group(1): tokens.append(('KEYWORD', match.group(1)))
        elif match.group(2): tokens.append(('OP', match.group(2)))
        elif match.group(3): tokens.append(('ID', match.group(3)))
        elif match.group(4): tokens.append(('HEX', match.group(4)))
        elif match.group(5): tokens.append(('NUM', float(match.group(5))))
        elif match.group(6): tokens.append(('PUNC', match.group(6)))
        elif match.group(7): tokens.append(('STRING', match.group(7).strip('"')))
    return tokens

def get_color(color_str):
    colors = {"WHITE": (255,255,255), "BLACK": (0,0,0), "RED": (255,0,0), "GREEN": (0,255,0), "BLUE": (0,0,255), "YELLOW": (255,255,0)}
    if color_str.startswith('#'):
        try: return ImageColor.getrgb(color_str)
        except: return (255,255,255)
    return colors.get(color_str.upper(), (255,255,255))

def get_blurred(data):
    if len(data.shape) == 2:
        padded = np.pad(data, ((1,1),(1,1)), mode='edge')
        return (padded[:-2,:-2] + padded[:-2,1:-1] + padded[:-2,2:] + padded[1:-1,:-2] + padded[1:-1,1:-1] + padded[1:-1,2:] + padded[2:,:-2] + padded[2:,1:-1] + padded[2:,2:]) / 9.0
    else:
        blurred = np.zeros_like(data, dtype=np.float64)
        for c in range(3):
            p = np.pad(data[:,:,c], ((1,1),(1,1)), mode='edge')
            blurred[:,:,c] = (p[:-2,:-2] + p[:-2,1:-1] + p[:-2,2:] + p[1:-1,:-2] + p[1:-1,1:-1] + p[1:-1,2:] + p[2:,:-2] + p[2:,1:-1] + p[2:,2:]) / 9.0
        return blurred

def clean_input(prompt):
    val = input(prompt).strip().replace(" ", "_")
    if not val: raise ValueError("Input cannot be empty.")
    return val

def get_int(prompt):
    while True:
        try: return int(input(prompt).strip())
        except ValueError: print("   [Error] Please enter a valid whole number.")

def get_float(prompt):
    while True:
        try: return float(input(prompt).strip())
        except ValueError: print("   [Error] Please enter a valid number.")

def show_vars(memory):
    vars = list(memory.keys())
    if vars: print(f"   [Available variables: {', '.join(vars)}]")
    else: print("   [No variables available yet]")

