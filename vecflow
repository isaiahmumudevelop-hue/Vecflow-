# MAIN EXECUTION (Required for PyPI/npm)
# ==========================================
def main():
    if len(sys.argv) > 1 and sys.argv[1] in ('--help', '-h'):
        interactive_help()
        sys.exit(0)

    persistent_memory = {}
    
    # Check if running a script file
    if len(sys.argv) > 1:
        filename = sys.argv[1]
        print(f"--- Running VecFlow Script: {filename} ---\n")
        try:
            with open(filename, 'r') as file:
                for line_number, line in enumerate(file, 1):
                    if line.strip():
                        print(f"Executing line {line_number}: {line.strip()}")
                        try: 
                            run_vecflow(line, persistent_memory)
                        except Exception as e: 
                            print(f"[Error on line {line_number}] {e}")
                            break 
        except FileNotFoundError: 
            print(f"[Error] Could not find file '{filename}'")
            
    # Interactive Mode (REPL)
    else:
        print("Welcome to VecFlow v5.0 (Ultimate Edition)!")
        print("Founder: Isaiah Micheal Asuquo")
        print("Type 'HELP' for commands or 'EXIT' to quit.\n")
        while True:
            try:
                user_input = input("VecFlow> ")
                if user_input.strip().upper() == 'EXIT': 
                    print("Goodbye!")
                    break
                if user_input.strip(): 
                    run_vecflow(user_input, persistent_memory)
            except Exception as e: 
                print(f"[Error] {e}")

if __name__ == "__main__":
    main()
