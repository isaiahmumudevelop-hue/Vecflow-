                else: filename = tokens[i+1][1]
                time.sleep(1)
                os.system(f"termux-open {filename}")
                print(f"[Engine] Opening '{filename}'...")
            except Exception as e: print(f"[Error] VIEW failed: {e}")
            i += 1 if is_interactive else 2
            
        elif token_value == 'RENDER':
            try:
                if is_interactive:
                    show_vars(memory)
                    var_name = clean_input("Enter variable to render: ")
                else: var_name = tokens[i+1][1]
                data = memory[var_name]['data']
                if memory[var_name]['rgb']: data = np.mean(data, axis=2)
                h, w = data.shape
                print("\n--- RENDERED IMAGE ---")
                ascii_chars = " .:-=+*#%@" 
                for y in range(0, min(h, 256), max(1, h//32)): 
                    row = "".join(ascii_chars[max(0, min(9, int(data[y, x] / 255 * 9)))] for x in range(0, min(w, 256), max(1, w//64)))
                    print(row)
                print("----------------------\n")
            except Exception as e: print(f"[Error] RENDER failed: {e}")
            i += 1 if is_interactive else 2
            
        elif token_value == 'OUTPUT':
            try:
                if is_interactive:
                    show_vars(memory)
                    var_name = clean_input("Enter variable to output: ")
                else: var_name = tokens[i+1][1]
                data = memory[var_name]['data'].flatten()
                print("\n--- FINAL OUTPUT ---")
                for j in range(min(10, len(data))): print(f"Slot {j}: {data[j]:.2f}")
                if len(data) > 10: print(f"... and {len(data) - 10} more pixels.")
            except Exception as e: print(f"[Error] OUTPUT failed: {e}")
            i += 1 if is_interactive else 2

        else:
            print(f"[Unknown Command] '{token_value}'. Type HELP to see the list of commands.")
            i += 1
    print("") 

def main():
    if len(sys.argv) > 1 and sys.argv[1] in ('--help', '-h'):
        interactive_help()
        sys.exit(0)

    persistent_memory = {}
    if len(sys.argv) > 1:
        filename = sys.argv[1]
        print(f"--- Running VecFlow Script: {filename} ---\n")
        try:
            with open(filename, 'r') as file:
                for line_number, line in enumerate(file, 1):
                    if line.strip():
                        print(f"Executing line {line_number}: {line.strip()}")
                        try: run_vecflow(line, persistent_memory)
                        except Exception as e: print(f"[Error on line {line_number}] {e}"); break 
        except FileNotFoundError: print(f"[Error] Could not find file '{filename}'")
    else:
        print("Welcome to VecFlow v5.1.1 (Cloudflare AI Edition)!")
        print("Founder: Isaiah Micheal Asuquo")
        print("Type 'HELP' for commands or 'EXIT' to quit.\n")
        print("💡 Pro-Tip: Type a command name (like AI, LOAD, CANVAS) and press Enter to use the interactive wizard!\n")
        while True:
            try:
                user_input = input("VecFlow> ")
                if user_input.strip().upper() == 'EXIT': 
                    print("Goodbye!"); break
                if user_input.strip(): run_vecflow(user_input, persistent_memory)
            except Exception as e: print(f"[Error] {e}")

if __name__ == "__main__":
    main()
